generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int                @id @default(autoincrement())
  email            String             @unique
  password         String
  role             Role
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @default(now()) @updatedAt
  admin            Admin?
  faculty          Faculty?
  file             File[]
  student          Student?
  studentUploadJob StudentUploadJob[]
}

model Student {
  id                Int                 @id @default(autoincrement())
  name              String
  phoneNo           String              @unique
  parentName        String
  parentPhoneNo     String
  rollNo            String              @unique
  regNo             String?             @unique
  section           String              @default("A")
  gender            Gender
  cgpa              Float?
  hosteller         Boolean
  admissionType     AdmissionType
  admissionDate     DateTime
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt
  isActive          Boolean             @default(true)
  userId            Int                 @unique
  deptId            Int
  semId             Int
  batchId           Int
  courseResult      CourseResult[]
  enrollment        Enrollment[]
  semResult         SemesterResult[]
  batch             Batch               @relation(fields: [batchId], references: [id])
  dept              Department          @relation(fields: [deptId], references: [id])
  sem               Semester            @relation(fields: [semId], references: [id])
  user              User                @relation(fields: [userId], references: [id])
  studentAssessment StudentAssessment[]
}

model Faculty {
  id              Int              @id @default(autoincrement())
  name            String
  phoneNo         String           @unique
  bio             String?
  designation     Designation
  specialization  String
  experience      Int
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  userId          Int              @unique
  deptId          Int
  courseOfferings CourseOffering[]
  hodDept         Department?      @relation("HOD")
  dept            Department       @relation("FacultyDepartment", fields: [deptId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
}

model Admin {
  id        Int      @id @default(autoincrement())
  name      String
  phoneNo   String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])
}

model File {
  id                Int                @id @default(autoincrement())
  fileName          String
  originalName      String
  s3Key             String             @unique
  mimeType          String
  size              Int?
  uploadedBy        Int
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  uploader          User               @relation(fields: [uploadedBy], references: [id])
  studentUploadFile StudentUploadJob[]
}

model StudentUploadJob {
  id                 Int                          @id @default(autoincrement())
  uploadedBy         Int
  fileId             Int
  totalRecords       Int                          @default(0)
  validRecords       Int                          @default(0)
  invalidRecords     Int                          @default(0)
  insertedRecords    Int                          @default(0)
  failedRecords      Int                          @default(0)
  status             UploadStatus                 @default(PROCESSING)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @default(now()) @updatedAt
  insertionFailures  StudentInsertionFailure[]
  file               File                         @relation(fields: [fileId], references: [id])
  uploader           User                         @relation(fields: [uploadedBy], references: [id])
  validationFailures StudentVerificationFailure[]
}

model StudentVerificationFailure {
  id          Int              @id @default(autoincrement())
  jobId       Int
  rowNumber   Int
  errorReason String
  rawData     Json
  createdAt   DateTime         @default(now())
  job         StudentUploadJob @relation(fields: [jobId], references: [id])
}

model StudentInsertionFailure {
  id          Int              @id @default(autoincrement())
  jobId       Int
  email       String?
  rollNo      String?
  regNo       String?
  errorReason String
  rawData     Json
  createdAt   DateTime         @default(now())
  job         StudentUploadJob @relation(fields: [jobId], references: [id])
}

model Department {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  deptCode  String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  isActive  Boolean    @default(true)
  hodId     Int?       @unique
  courses   Course[]
  hod       Faculty?   @relation("HOD", fields: [hodId], references: [id])
  faculties Faculty[]  @relation("FacultyDepartment")
  labs      Lab[]
  semesters Semester[]
  students  Student[]
}

model Semester {
  id         Int              @id @default(autoincrement())
  number     Int
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @default(now()) @updatedAt
  deptId     Int
  courses    Course[]
  dept       Department       @relation(fields: [deptId], references: [id])
  semResults SemesterResult[]
  students   Student[]

  @@unique([deptId, number])
}

model Batch {
  id               Int              @id @default(autoincrement())
  startYear        Int
  endYear          Int
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  coursesOfferings CourseOffering[]
  students         Student[]

  @@unique([startYear, endYear])
}

model Lab {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  roomNo    String
  capacity  Int
  deptId    Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  dept      Department @relation(fields: [deptId], references: [id])
}

model Course {
  id               Int              @id @default(autoincrement())
  courseCode       String           @unique
  title            String
  description      String?
  credits          Int
  deptId           Int
  semId            Int
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  dept             Department       @relation(fields: [deptId], references: [id])
  sem              Semester         @relation(fields: [semId], references: [id])
  coursesOfferings CourseOffering[]
}

model CourseOffering {
  id                  Int                   @id @default(autoincrement())
  courseId            Int
  facultyId           Int
  batchId             Int
  section             String                @default("A")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now()) @updatedAt
  assessmentComponent AssessmentComponent[]
  batch               Batch                 @relation(fields: [batchId], references: [id])
  course              Course                @relation(fields: [courseId], references: [id])
  faculty             Faculty               @relation(fields: [facultyId], references: [id])
  courseResult        CourseResult[]
  enrollment          Enrollment[]

  @@unique([courseId, batchId, section])
}

model Enrollment {
  id               Int              @id @default(autoincrement())
  studentId        Int
  courseOfferingId Int
  status           EnrollmentStatus @default(ACTIVE)
  offering         CourseOffering   @relation(fields: [courseOfferingId], references: [id])
  student          Student          @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseOfferingId])
}

model CourseResult {
  id               Int            @id @default(autoincrement())
  studentId        Int
  courseOfferingId Int
  internalMarks    Float?
  endSemMarks      Float?
  grade            Grade?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id])
  student          Student        @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseOfferingId])
}

model SemesterResult {
  id           Int      @id @default(autoincrement())
  studentId    Int
  semId        Int
  sgpa         Float
  totalCredits Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  sem          Semester @relation(fields: [semId], references: [id])
  student      Student  @relation(fields: [studentId], references: [id])

  @@unique([studentId, semId])
}

model AssessmentComponent {
  id                Int                 @id @default(autoincrement())
  courseOfferingId  Int
  name              String
  maxMarks          Int?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt
  courseOffering    CourseOffering      @relation(fields: [courseOfferingId], references: [id])
  studentAssessment StudentAssessment[]
}

model StudentAssessment {
  id          Int                 @id @default(autoincrement())
  studentId   Int
  componentId Int
  marks       Float
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @default(now()) @updatedAt
  component   AssessmentComponent @relation(fields: [componentId], references: [id])
  student     Student             @relation(fields: [studentId], references: [id])

  @@unique([studentId, componentId])
}

enum Role {
  ADMIN
  STUDENT
  FACULTY
}

enum Gender {
  MALE
  FEMALE
  TRANSGENDER
}

enum AdmissionType {
  REGULAR
  LATERAL_ENTRY
}

enum FileVisibility {
  PRIVATE
  ENROLLED
  PUBLIC
}

enum EntityType {
  ADMISSION
  ATTENDANCE
  COURSE
  ASSIGNMENT
  QUIZ
}

enum UploadStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum Designation {
  PROFESSOR
  ASST_PROFESSOR
}

enum Grade {
  A_PLUS
  B
  C
  D
  P
  F
}
