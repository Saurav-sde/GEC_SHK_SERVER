// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STUDENT
  FACULTY
}

enum Gender {
  MALE
  FEMALE
  TRANSGENDER
}

enum AdmissionType {
  REGULAR
  LATERAL_ENTRY
}

enum FileVisibility {
  PRIVATE
  ENROLLED
  PUBLIC
}

enum EntityType {
  ADMISSION
  ATTENDANCE
  COURSE 
  ASSIGNMENT
  QUIZ
}

enum UploadStatus {
  PROCESSING
  COMPLETED
  FAILED
}


model User {
  id Int @id @default(autoincrement())
  email String @unique
  password String
  role Role
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  student Student?
  faculty Faculty?
  admin Admin?

  file File[]
  studentUploadJob StudentUploadJob[]
}

// academic structure
model Department {
  id Int @id @default(autoincrement())
  name String @unique
  deptCode String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
  isActive Boolean @default(true)

  hod Faculty? @relation("HOD",fields: [hodId], references: [id], onDelete: SetNull)
  hodId Int? @unique

  students Student[]
  faculties Faculty[] @relation("FacultyDepartment")
  semesters Semester[]

}

model Semester {
  id Int @id @default(autoincrement())
  number Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  dept Department @relation(fields: [deptId], references: [id])
  deptId Int

  students Student[]

  @@unique([deptId, number])
}

model Batch {
  id Int @id @default(autoincrement())
  name String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  students Student[]
}

// users
model Student {
  id Int @id @default(autoincrement())
  name String
  phoneNo String @unique
  parentName String
  parentPhoneNo String 
  rollNo String @unique
  regNo String? @unique
  section String @default("A")
  gender Gender

  hosteller Boolean
  admissionType AdmissionType
  admissionDate DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
  isActive Boolean @default(true)

  user User @relation(fields: [userId], references: [id])
  userId Int @unique

  dept Department @relation(fields: [deptId], references: [id])
  deptId Int 

  sem Semester @relation(fields: [semId], references: [id])
  semId Int 

  batchId Int
  batch Batch @relation(fields: [batchId], references: [id])
}

model Faculty {
  id Int @id @default(autoincrement())
  name String 
  phoneNo String @unique
  regNo String @unique
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  user User @relation(fields: [userId], references: [id])
  userId Int @unique

  dept Department @relation("FacultyDepartment", fields: [deptId], references: [id])
  deptId Int

  hodDept Department? @relation("HOD")
}

model Admin {
  id Int @id @default(autoincrement())
  name String
  phoneNo String @unique
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  userId Int @unique
  user User @relation(fields: [userId], references: [id])
}


model File {
  id Int @id @default(autoincrement())

  fileName String
  originalName String
  s3Key String @unique
  mimeType String
  size Int?

  uploadedBy Int
  uploader User @relation(fields: [uploadedBy], references: [id])

  studentUploadFile StudentUploadJob[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}


model StudentUploadJob {
  id Int @id @default(autoincrement())
  
  uploadedBy Int
  uploader User @relation(fields: [uploadedBy], references: [id])

  fileId Int
  file File @relation(fields: [fileId], references: [id])

  totalRecords Int @default(0)
  validRecords Int @default(0)
  invalidRecords Int @default(0)

  insertedRecords Int @default(0)
  failedRecords Int @default(0)

  status UploadStatus @default(PROCESSING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  validationFailures StudentVerificationFailure[]
  insertionFailures StudentInsertionFailure[]
}


model StudentVerificationFailure {
  id Int @id @default(autoincrement())

  jobId Int
  job StudentUploadJob @relation(fields: [jobId], references: [id])

  rowNumber Int
  errorReason String

  rawData Json

  createdAt DateTime @default(now())
}


model StudentInsertionFailure {
  id Int @id @default(autoincrement())

  jobId Int
  job StudentUploadJob @relation(fields: [jobId], references: [id])

  email String?
  rollNo String?
  regNo String?

  errorReason String
  rawData Json

  createdAt DateTime @default(now())
}